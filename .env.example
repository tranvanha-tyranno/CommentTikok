SIGNALDESK_DATA_DIR=./data
SIGNALDESK_WORKERS=2
# Leave blank to use yt-dlp for YouTube. API mode supports search and full reply pagination.
YOUTUBE_API_KEY=
# Optional OpenAI-compatible server, including local Ollama /v1.
LLM_BASE_URL=http://localhost:11434/v1
LLM_MODEL=
LLM_API_KEY=
# Local HTTP app is loopback-only by default. Set a token before exposing it on a network.
SIGNALDESK_TOKEN=
